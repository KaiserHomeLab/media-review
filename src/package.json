    "typecheck": "tsc -p ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KaiserHomeLab/media-review.git"
  },
  "author": "KaiserHomeLab",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
